# =============================================================================
# W3C ETL Pipeline — Environment Configuration (example)
# =============================================================================
# For Azure runs: copy .env.azure.template to .env.azure and fill in real
# values. NEVER commit .env.azure to version control.
# For local dev: source the same keys (export or direnv) with local values.
# =============================================================================

# Azure credentials (service principal)
ARM_CLIENT_ID=
ARM_CLIENT_SECRET=
ARM_SUBSCRIPTION_ID=
ARM_TENANT_ID=

# Databricks
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Azure SQL
AZURE_SQL_SERVER=
AZURE_SQL_DB=w3c-etl-db
AZURE_SQL_USER=sqladmin
AZURE_SQL_PASSWORD=

# Storage
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=

# dbt
DBT_PROFILE=w3c_azure

# Databricks Workflow
DATABRICKS_WORKFLOW_ID=
