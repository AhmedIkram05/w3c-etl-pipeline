# Secrets — never commit
.env
.env.azure
.vscode

# macOS junk
.DS_Store

# Python bytecode
dags/w3c/__pycache__/
**/__pycache__/
*.pyc
*.pyo

# Airflow runtime files — these are generated, not source
logs/
airflow.db
airflow.cfg
pipeline-webserver.pid
standalone_admin_password.txt

# dbt docs source files (copied from target/ then synced to docs/dbt/ for GH Pages)
# GH Pages served from: pipeline/data/dbt-docs/ → docs/dbt/

# MaxMind GeoLite2 databases — too large, download manually per Phase 0
/data/geoip/
copilot-instructions.md
.agents

# dbt — build artifacts
pipeline/dbt/w3c/target/
pipeline/dbt/w3c/dbt_packages/

# dbt anonymous usage id (per developer, not project configuration)
pipeline/dbt/.user.yml

# Prometheus — runtime data (config is version-controlled separately)
prometheus/data/

# Grafana — runtime data (provisioning config is version-controlled)
grafana/data/
AGENTS.md

# Spark Delta Lake data (generated at runtime)
pipeline/spark/delta/*
!pipeline/spark/delta/.gitkeep

# Terraform — provider binaries per environment
**/.terraform/

# Terraform state files — never commit
*.tfstate
*.tfstate.*

# Terraform plan files — binary, environment-specific, may embed sensitive values
tfplan
*.tfplan

# Pre-commit
.pre-commit-cache/

utils.zip

graphify-out
w3c_etl_pipeline.egg-info

# Local virtualenv + tool caches
.venv/
.uv-cache/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Coverage reports
.coverage*
coverage.xml
htmlcov/

# Logs and local env
*.log
pipeline/.env

# IDE
.idea/

